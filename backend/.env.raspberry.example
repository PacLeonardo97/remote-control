# Copie para backend/.env no Raspberry Pi e preencha API_TOKEN.
API_HOST=0.0.0.0
API_PORT=3001
# Gere com: openssl rand -hex 32
API_TOKEN=
# Opcional: IP inicial da TV. Tambem pode ser configurado pela interface.
# TV_HOST=192.168.1.50
TV_PORT=5555
# MAC da TV para Wake-on-LAN quando o ADB cai em standby.
# TV_MAC=08:c3:b3:24:ef:93
