API_HOST=127.0.0.1
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Required if API_HOST is not loopback. Use a long random value.
# API_TOKEN=
# Optional initial TV address; UI settings override it and persist in backend/data/config.json.
# TV_HOST=192.168.1.50
TV_PORT=5555
# TV_MAC=08:c3:b3:24:ef:93
# APP_YOUTUBE=com.google.android.youtube.tv
# APP_NETFLIX=com.netflix.ninja
# APP_PRIME=com.amazon.amazonvideo.livingroom
# APP_DISNEY=com.disney.disneyplus
# Remote Protocol deep links; adjust if an app on your TV needs a different link.
# REMOTE_APP_YOUTUBE=https://www.youtube.com
# REMOTE_APP_NETFLIX=netflix://
# REMOTE_APP_PRIME=https://app.primevideo.com
# REMOTE_APP_DISNEY=https://www.disneyplus.com
